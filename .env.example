# =========================================================================
# Exemple de configuration. Copier ce fichier en « .env » puis adapter.
#   cp .env.example .env
# Le fichier « .env » NE DOIT JAMAIS etre commite (deja ignore par git).
# =========================================================================

# --- Django ---------------------------------------------------------------
# Genere une cle unique :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-moi-par-une-cle-unique-et-secrete
DEBUG=False
# Liste des hotes separes par des virgules (domaines et/ou IP du serveur).
ALLOWED_HOSTS=miraclekidsshop.alwaysdata.net,127.0.0.1,localhost
# Origines de confiance pour le CSRF (schema + domaine, separes par des virgules).
CSRF_TRUSTED_ORIGINS=https://miraclekidsshop.alwaysdata.net

# --- API / CORS (application Flutter) ------------------------------------
CORS_ALLOWED_ORIGINS=

# --- Emails (Brevo / SMTP) ------------------------------------------------
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=elengaomerfils@gmail.com

# --- URL publique et protocole -------------------------------------------
SITE_BASE_URL=https://miraclekidsshop.alwaysdata.net
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# --- Connexion Google (allauth) ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT (application mobile) --------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Securite (utilise quand DEBUG=False) --------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Mettre True seulement si le site est bien servi en HTTPS (sinon boucle).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# =========================================================================
# Parametres utilises par les scripts de deploiement (deploy/*.sh).
# Ils ne sont pas lus par Django.
# =========================================================================
# NB : sur alwaysdata (PaaS), le serveur uWSGI est fourni par la plateforme et
# le bloc GUNICORN_* ci-dessous est ignore (voir deploy/deploy_alwaysdata.sh).
# Utilisateur Linux non-root qui fera tourner l'application.
APP_USER=stock
# Dossier d'installation de l'application sur le serveur.
APP_DIR=/var/www/stock
# Depot Git a cloner (laisser vide si le code est deja copie).
REPO_URL=https://github.com/like2300/luxe-stock.git
# Interface/port d'ecoute de Gunicorn. Utiliser 0.0.0.0:80 pour le port HTTP
# par defaut (voir les commentaires dans deploy/stockpro.service.template).
GUNICORN_BIND=0.0.0.0:8000
# Nombre de workers Gunicorn (vide = detecte automatiquement).
GUNICORN_WORKERS=
GUNICORN_LOGLEVEL=info
